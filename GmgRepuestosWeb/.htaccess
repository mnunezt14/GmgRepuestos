# =====================================================================
#  GMG Repuestos - reglas generales del sitio (Hostinger: LiteSpeed/Apache)
#
#  Este archivo va en la carpeta principal del sitio (public_html).
#  Hace cuatro cosas:
#    1) Obliga a usar HTTPS (candado de seguridad) en todo el sitio.
#    2) Agrega las cabeceras de seguridad del navegador.
#    3) Bloquea el acceso por internet a archivos internos (claves, bases
#       de datos, documentos, registros).
#    4) Evita que se pueda listar el contenido de las carpetas.
#
#  IMPORTANTE: para que la redirección a HTTPS funcione, primero hay que
#  activar el certificado SSL en hPanel (Seguridad > SSL). El sitio también
#  hace la misma redirección desde PHP como respaldo.
# =====================================================================

# 4) Nadie puede ver el listado de archivos de una carpeta.
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 0) Una sola dirección: gmgrepuestos.cl -> https://www.gmgrepuestos.cl (301), con la misma ruta y
    #    parámetros. Es la versión que usan SITE_URL, la URL canónica y el sitemap. Solo afecta a ese
    #    dominio exacto (no al computador ni a otros subdominios).
    RewriteCond %{HTTP_HOST} ^gmgrepuestos\.cl(:[0-9]+)?$ [NC]
    RewriteRule ^ https://www.gmgrepuestos.cl%{REQUEST_URI} [L,R=301,NE]

    # 1) HTTPS obligatorio (redirección permanente). No se aplica cuando se
    #    prueba en el computador (localhost) ni cuando el servidor ya recibió
    #    la visita por HTTPS a través de un intermediario.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # URLs legibles de las fichas (F4-2): /repuestos/swift/pastillas-de-freno-255 -> producto.php?id=255.
    # La variable avisa a PHP que el servidor reescribe (en el computador, con php -S, no existe).
    RewriteRule ^ - [E=GMG_REESCRITURA:1]
    RewriteRule ^repuestos/[a-z0-9-]+/[a-z0-9-]*-([0-9]+)/?$ producto.php?id=$1 [L,QSA]

    # 3) Carpetas internas que nunca deben abrirse desde internet (no se suben
    #    al hosting, pero si alguna llega por error queda bloqueada igual).
    RewriteRule ^(BD_v2|docs|arquitectura|tests|\.claude|\.git|backend/parciales)(/|$) - [F,L,NC]

    # Mapa del sitio para buscadores (F4-1): /sitemap.xml lo arma sitemap.php.
    RewriteRule ^sitemap\.xml$ sitemap.php [L]
</IfModule>

# 5) Rendimiento (F4-7): compresión y caché del navegador. El CSS y el JS llevan ?v=<fecha del
#    archivo>, así que pueden guardarse un año: al cambiar el archivo cambia la dirección.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json application/xml image/svg+xml text/plain
</IfModule>
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

# 2) Cabeceras de seguridad. (El sitio también las envía desde PHP; si ya
#    estaban puestas, estas líneas simplemente las reemplazan sin duplicarlas.)
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    # El navegador recordará durante 1 año que este sitio solo se abre con HTTPS.
    Header set Strict-Transport-Security "max-age=31536000" env=HTTPS
</IfModule>

# 3) Archivos que no se pueden descargar desde internet: claves (.env),
#    scripts y volcados de base de datos, documentos de trabajo, registros,
#    respaldos y archivos ocultos.
<FilesMatch "(?i)(^\.|\.(env|sql|md|log|bak|old|tmp|csv|ini|sh|yml|yaml|lock|dist|example|docx|xlsx)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
