# Plantilla de configuración de GMG Repuestos.
# Copia este archivo como ".env" y completa los valores. El ".env" real nunca se sube a Git.
# En Hostinger, deja el ".env" una carpeta más arriba de public_html (el código lo busca primero ahí).

# Ambiente: "pruebas" o "produccion" (si queda vacío, se asume produccion)
APP_ENV=
# URL pública del sitio, sin barra final (ej. https://www.ejemplo.cl). Vacío: se deduce del dominio.
SITE_URL=
# 1 = verificar certificados en llamadas a OpenAI y Mercado Pago (recomendado). 0 solo para diagnosticar.
CURL_VERIFICAR_SSL=1

# Base de datos MySQL / MariaDB
DB_HOST=localhost
DB_USER=
DB_PASS=
DB_NAME=

# Asistente IA (OpenAI). En pruebas, usa una clave con límite de gasto.
AI_API_KEY=
# Solo con APP_ENV=pruebas: dirección de una API falsa local para las pruebas (tests/fake_openai.php).
# Vacío = OpenAI. En producción se ignora.
AI_API_URL=

# WhatsApp de la tienda, con código de país y sin "+" (ej. 569XXXXXXXX)
WHATSAPP_NUMBER=

# Mercado Pago (credenciales de prueba en el ambiente de pruebas)
MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=

# Correo saliente (SMTP de Hostinger)
SMTP_HOST=smtp.hostinger.com
# Opcional: 465 con ssl (por defecto) o 587 con tls si el 465 no conecta
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=GMG Repuestos

# Google Analytics 4 (ID de medición de GMG, ej. G-ABC123XYZ). Vacío: no se carga Analytics.
GA4_ID=
