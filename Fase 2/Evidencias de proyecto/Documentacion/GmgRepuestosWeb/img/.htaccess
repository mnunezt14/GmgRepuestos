# Carpeta de imágenes: aquí solo se muestran fotos. Si alguien lograra subir
# un archivo con código, igual no se ejecutaría.
<FilesMatch "(?i)\.(php[0-9]?|phtml|phar|pl|py|cgi|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
